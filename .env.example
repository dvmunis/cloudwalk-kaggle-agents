# Kaggle API token: kaggle.com > Settings > API > Generate New Token (starts with KGAT_)
KAGGLE_API_TOKEN=

# LLM for the agents: console.groq.com > API Keys (free tier)
GROQ_API_KEY=
# Optional: override the Groq model used by every agent (default openai/gpt-oss-120b)
GROQ_MODEL=
# Optional: model used when GROQ_MODEL runs out of daily quota (default openai/gpt-oss-20b)
GROQ_FALLBACK_MODEL=
